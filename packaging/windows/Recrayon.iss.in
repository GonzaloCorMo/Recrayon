; Inno Setup script for Recrayon. Generated by CMake from packaging/windows/Recrayon.iss.in:
; build it with `cmake --build --preset <preset> --target installer`.
;
; Per-user install, no administrator rights: %LOCALAPPDATA%\Programs\Recrayon, Start menu
; entry, optional desktop icon and start at sign-in, uninstaller in "Installed apps".

#define AppName "Recrayon"
#define AppVersion "@PROJECT_VERSION@"
#define AppExe "recrayon.exe"
#define StagingDir "@RECRAYON_STAGING_DIR@"

[Setup]
; Never change AppId: it identifies the installed app for upgrades and uninstall.
AppId={{6F1D3A52-8C4E-4B7A-9E21-5D0C7B3A9F64}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=Recrayon
AppComments=@PROJECT_DESCRIPTION@
VersionInfoVersion={#AppVersion}
PrivilegesRequired=lowest
DefaultDirName={autopf}\{#AppName}
DisableProgramGroupPage=yes
DisableDirPage=auto
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Qt 6.8 needs Windows 10 1809 or later.
MinVersion=10.0.17763
LicenseFile=@PROJECT_SOURCE_DIR@/LICENSE
SetupIconFile=@RECRAYON_ICON_FILE@
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
OutputDir=@RECRAYON_INSTALLER_OUTPUT_DIR@
OutputBaseFilename=Recrayon-{#AppVersion}-setup
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
; Recrayon lives in the tray without a main window, so it is closed by PrepareToInstall below.
CloseApplications=no

[Languages]
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
spanish.StartAtSignIn=Iniciar Recrayon al iniciar sesión en Windows
english.StartAtSignIn=Start Recrayon when I sign in to Windows
spanish.StartupGroup=Inicio:
english.StartupGroup=Startup:
spanish.UpgradeQuestion=Recrayon %1 ya está instalado.%n%n¿Quieres actualizarlo a la versión %2? Tus ajustes se conservan.
english.UpgradeQuestion=Recrayon %1 is already installed.%n%nDo you want to update it to version %2? Your settings are kept.
spanish.ReinstallQuestion=Recrayon %1 ya está instalado.%n%n¿Quieres reinstalarlo?
english.ReinstallQuestion=Recrayon %1 is already installed.%n%nDo you want to reinstall it?
spanish.DowngradeQuestion=Hay instalada una versión más nueva de Recrayon (%1).%n%n¿Quieres sustituirla por la versión %2?
english.DowngradeQuestion=A newer version of Recrayon (%1) is installed.%n%nDo you want to replace it with version %2?

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "startup"; Description: "{cm:StartAtSignIn}"; GroupDescription: "{cm:StartupGroup}"; Flags: unchecked

[Files]
Source: "{#StagingDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon
Name: "{userstartup}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: startup

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{sys}\taskkill.exe"; Parameters: "/IM {#AppExe} /F"; Flags: runhidden; RunOnceId: "StopRecrayon"

[Code]
const
  UninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{6F1D3A52-8C4E-4B7A-9E21-5D0C7B3A9F64}_is1';

// Version of the Recrayon already installed (same AppId), or '' if there is none.
function InstalledVersion(): String;
begin
  Result := '';
  if not RegQueryStringValue(HKCU, UninstallKey, 'DisplayVersion', Result) then
    RegQueryStringValue(HKLM, UninstallKey, 'DisplayVersion', Result);
end;

// An existing installation is updated in place (same folder, settings and chosen tasks); ask
// first so the user knows what is going to happen. Silent installs (/SILENT, /VERYSILENT)
// update without asking.
function InitializeSetup(): Boolean;
var
  Installed, Question: String;
  InstalledPacked, NewPacked: Int64;
  Order: Integer;
begin
  Result := True;
  Installed := InstalledVersion();
  if Installed = '' then
    Exit;

  Order := -1;
  if StrToVersion(Installed, InstalledPacked) and StrToVersion('{#AppVersion}', NewPacked) then
    Order := ComparePackedVersion(InstalledPacked, NewPacked);

  if Order = 0 then
    Question := FmtMessage(CustomMessage('ReinstallQuestion'), [Installed])
  else if Order > 0 then
    Question := FmtMessage(CustomMessage('DowngradeQuestion'), [Installed, '{#AppVersion}'])
  else
    Question := FmtMessage(CustomMessage('UpgradeQuestion'), [Installed, '{#AppVersion}']);

  Result := SuppressibleMsgBox(Question, mbConfirmation, MB_YESNO, IDYES) = IDYES;
end;

// Close a running Recrayon (upgrade / reinstall) so its files can be replaced.
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ResultCode: Integer;
begin
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/IM {#AppExe} /F', '', SW_HIDE,
       ewWaitUntilTerminated, ResultCode);
  Result := '';
end;
