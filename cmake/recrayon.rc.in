// Generated by CMake from cmake/recrayon.rc.in. Do not edit.
// Windows resources of recrayon.exe: the icon Explorer shows and the version details.
#include <winver.h>

IDI_ICON1 ICON "@RECRAYON_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS VOS__WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Recrayon"
            VALUE "FileDescription", "Recrayon"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "recrayon"
            VALUE "LegalCopyright", "Copyright (c) 2026 Gonzalo Cordeiro Mourelle. CC BY-NC-ND 4.0"
            VALUE "OriginalFilename", "recrayon.exe"
            VALUE "ProductName", "Recrayon"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
